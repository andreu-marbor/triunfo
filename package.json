{
  "name": "triunfo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solitario Klondike con baraja española y reparto garantizado ganable — PWA + TWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prueba": "npm run prueba:i18n && npm run prueba:cartas && npm run prueba:motor && npm run prueba:solver && npm run prueba:reparto && npm run prueba:diaria && npm run prueba:estadisticas && npm run prueba:pantallas",
    "prueba:i18n": "esbuild pruebas/i18n.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/i18n.mjs --log-level=warning && node node_modules/.tmp/i18n.mjs",
    "prueba:cartas": "esbuild pruebas/cartas.ts --bundle --platform=node --outfile=node_modules/.tmp/cartas.mjs --log-level=warning && node node_modules/.tmp/cartas.mjs",
    "prueba:motor": "esbuild pruebas/motor.ts --bundle --platform=node --outfile=node_modules/.tmp/motor.mjs --log-level=warning && node node_modules/.tmp/motor.mjs",
    "prueba:solver": "esbuild pruebas/solver.ts --bundle --platform=node --outfile=node_modules/.tmp/solver.mjs --log-level=warning && node node_modules/.tmp/solver.mjs",
    "prueba:reparto": "esbuild pruebas/reparto.ts --bundle --platform=node --outfile=node_modules/.tmp/reparto.mjs --log-level=warning && node node_modules/.tmp/reparto.mjs",
    "prueba:diaria": "esbuild pruebas/diaria.ts --bundle --platform=node --outfile=node_modules/.tmp/diaria.mjs --log-level=warning && node node_modules/.tmp/diaria.mjs",
    "prueba:estadisticas": "esbuild pruebas/estadisticas.ts --bundle --platform=node --outfile=node_modules/.tmp/estadisticas.mjs --log-level=warning && node node_modules/.tmp/estadisticas.mjs",
    "prueba:pantallas": "esbuild pruebas/pantallas.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.tmp/pantallas.mjs --log-level=warning && node node_modules/.tmp/pantallas.mjs",
    "iconos": "node scripts/generar-iconos.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
