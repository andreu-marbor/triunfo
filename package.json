{
  "name": "triunfo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solitario Klondike con baraja española y reparto garantizado ganable — PWA + TWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prueba": "npm run prueba:i18n && npm run prueba:cartas && npm run prueba:motor && npm run prueba:solver && npm run prueba:reparto",
    "prueba:i18n": "esbuild pruebas/i18n.ts --bundle --platform=node --outfile=node_modules/.tmp/i18n.mjs --log-level=warning && node node_modules/.tmp/i18n.mjs",
    "prueba:cartas": "esbuild pruebas/cartas.ts --bundle --platform=node --outfile=node_modules/.tmp/cartas.mjs --log-level=warning && node node_modules/.tmp/cartas.mjs",
    "prueba:motor": "esbuild pruebas/motor.ts --bundle --platform=node --outfile=node_modules/.tmp/motor.mjs --log-level=warning && node node_modules/.tmp/motor.mjs",
    "prueba:solver": "esbuild pruebas/solver.ts --bundle --platform=node --outfile=node_modules/.tmp/solver.mjs --log-level=warning && node node_modules/.tmp/solver.mjs",
    "prueba:reparto": "esbuild pruebas/reparto.ts --bundle --platform=node --outfile=node_modules/.tmp/reparto.mjs --log-level=warning && node node_modules/.tmp/reparto.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
